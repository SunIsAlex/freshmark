[Unit]
Description=Freshmark verification email API
After=network-online.target postfix.service
Wants=network-online.target
Requires=postfix.service

[Service]
Type=simple
User=freshmail
Group=freshmail
SupplementaryGroups=postdrop
EnvironmentFile=/etc/freshmark-mailer.env
ExecStart=/usr/bin/node /opt/freshmark-mailer/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/spool/postfix/maildrop /var/spool/postfix/public
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
